{
  "name": "whatisgeo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node tools/postbuild.mjs",
    "check": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "preview": "wrangler dev --port 8787 --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "og": "node tools/render-og.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.2",
    "marked": "18.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/node": "^22.0.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "wrangler": "4.131.2"
  }
}
