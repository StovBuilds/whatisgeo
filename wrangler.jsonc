{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatisgeo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "vars": { "SITE_URL": "https://whatisgeo.app" },
  "ratelimits": [{ "name": "SIGNUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "SIGNUPS", "class_name": "SignupMailbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignupMailbox"] }]
}
