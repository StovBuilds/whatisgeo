---
import Base from '../layouts/Base.astro';
import { ui } from '../data/content';
---
<Base title="Confirm your email | What is GEO" description="Confirm your subscription to What is GEO guides and course updates." noindex><main class="utility-page" id="main"><p class="eyebrow">One more thing</p><h1>Confirm your email.</h1><div class="prose"><p id="confirm-message" role="status">Click the button below to finish subscribing. Your subscription starts after you confirm.</p></div><button class="confirm-button" id="confirm-button" type="button">{ui.confirmButton} ↗</button><noscript><p>Please enable JavaScript to confirm your email securely.</p></noscript><div><a class="text-link" href="/#updates">Back to the guide ↗</a></div></main></Base>
