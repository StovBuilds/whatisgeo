---
// /guides/: every guide, as a folder of six folders (design/site/DESIGN.md §4). Full summaries, never cut off.
import Base from '../../layouts/Base.astro';
import FileRail from '../../components/FileRail.astro';
import FileBar from '../../components/FileBar.astro';
import { site } from '../../data/content';
import { guidesIn, categoriesWithGuides, guides, lastUpdated } from '../../lib/guides';
import { guideStats } from '../../lib/site-files';
const cats = categoriesWithGuides();
const fmt = (n: number) => n.toLocaleString('en-GB');
const fmtDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${site.url}/guides/#page`, url: `${site.url}/guides/`, name: 'GEO guides', inLanguage: 'en-GB', isPartOf: { '@id': `${site.url}/#website` },
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}${g.url}`, name: g.fm.title })) } };
---
<Base title="GEO guides: AI search, AEO, llms.txt and more | What is GEO" description="Plain-English, source-linked guides to Generative Engine Optimisation, answer engine optimisation, Google AI Overviews, ChatGPT visibility and llms.txt." current="guides">
  <main id="main">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <div class="lf-shell" data-page="guides">
      <FileRail page="guides" />
      <div class="lf-pane">
        <nav class="ds-breadcrumb lf-crumbs" aria-label="Breadcrumb"><ol class="ds-breadcrumb__list">
          <li class="ds-breadcrumb__item"><a class="ds-breadcrumb__link" href="/">What is GEO</a><span class="ds-breadcrumb__sep" aria-hidden="true"></span></li>
          <li class="ds-breadcrumb__item"><span class="ds-breadcrumb__leaf" aria-current="page">Guides</span></li>
        </ol></nav>
        <FileBar name="guides/" meta={[`${guides.length} files`, `${cats.length} folders`, `Last updated ${fmtDate(lastUpdated())}`]} href="/llms.txt" label="All of them in llms.txt" />
        <header class="lf-in lf-intro lf-intro--page">
          <h1 class="lf-h1">Every guide, one question each</h1>
          <p class="lf-p">Each page answers one question about AI search directly, then shows its sources. Every guide is also a Markdown file at its own address plus .md. New to this? Start with <a class="ds-text-link" href="/guide/">the full GEO guide</a>.</p>
        </header>
        {cats.length === 0 ? <p class="lf-in lf-p">The first guides are on their way.</p> : cats.map(c => { const list = guidesIn(c.id); return (
          <section class="lf-sec lf-in lf-cat" id={c.id} aria-labelledby={`${c.id}-title`}>
            <div class="lf-cat__head"><h2 class="lf-h2" id={`${c.id}-title`}>{c.title}</h2><span class="lf-cat__n">{c.id}/ · {list.length} file{list.length === 1 ? '' : 's'}</span></div>
            <p class="lf-cat__blurb">{c.blurb}</p>
            <ul class="lf-rows">{list.map(g => { const s = guideStats(g); return <li class="lf-row" data-kind="next"><a class="lf-row__t" href={g.url}>{g.fm.title}</a><p class="lf-row__s">{g.fm.summary}</p><span class="lf-row__m">{g.slug}.md · {fmt(s.words)} words · {s.sources} sources</span></li>; })}</ul>
          </section>); })}
      </div>
    </div>
  </main>
</Base>
