---
// Home: the stage hero (unchanged, src/components/StageHero.astro), then the site as files (design/site/DESIGN.md §4):
// guide.md's opening lines, its nine chapters by line, three guides per category, sign-up. The long guide lives at
// /guide/ since the linefile redesign (Jack, 2026-11-10); the old /#guide and /#<chapter> links hop there.
import Base from '../layouts/Base.astro';
import '../styles/stage.css';
import StageHero from '../components/StageHero.astro';
import FileRail from '../components/FileRail.astro';
import FileBar from '../components/FileBar.astro';
import Signup from '../components/Signup.astro';
import { site } from '../data/content';
import { renderLines } from '../lib/linefile';
import { guideFile, guideStats, guides, guidesIn, categoriesWithGuides } from '../lib/site-files';
const gf = guideFile();
const opening = renderLines(gf.lines, 1, gf.chapters[0].to);
const cats = categoriesWithGuides();
const fmt = (n: number) => n.toLocaleString('en-GB');
const second = gf.chapters[1];
const publisher = { '@type': 'Organization', '@id': `${site.publisher.url}#organization`, name: site.publisher.name, url: site.publisher.url, sameAs: [site.publisher.hilyt], identifier: '10047328', address: { '@type': 'PostalAddress', streetAddress: '5 Brayford Square', addressLocality: 'London', postalCode: 'E1 0SG', addressCountry: 'GB' }, vatID: 'GB362654684' };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, description: site.description, inLanguage: 'en-GB', publisher: { '@id': publisher['@id'] }, sameAs: [site.hilyt], hasPart: { '@id': `${site.url}/guide/#article` } },
  publisher
] };
// Old links into the guide when it lived on this page.
const hops = ['guide', ...gf.chapters.map(c => c.id)];
---
<Base title="What is GEO? A practical guide to Generative Engine Optimisation" description="Learn what GEO means, how AI answers find sources, and how to make your website useful, discoverable and easier to cite. A practical beginner's guide.">
  <script is:inline define:vars={{ hops }}>function hop() { if (hops.includes(location.hash.slice(1))) location.replace('/guide/' + (location.hash === '#guide' ? '' : location.hash)); } hop(); addEventListener('hashchange', hop);</script>
  <main id="main">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <StageHero />
    <div class="lf-shell" data-page="home">
      <FileRail page="home" />
      <div class="lf-pane">
        <section class="lf-sec lf-sec--first" aria-labelledby="file-title">
          <div class="lf-in lf-intro">
            <h2 class="lf-h2" id="file-title">The guide is one file</h2>
            <p class="lf-p">Everything here starts from guide.md. The numbers down the left are its real line numbers, the same lines the answer above points to. Blank lines are skipped, never renumbered.</p>
          </div>
          <FileBar name="guide.md" meta={[`${gf.count} lines`, `${fmt(gf.words)} words`, `${gf.minutes} min read`]} href="/guide.md" />
          <div class="lf-doc" aria-label={`guide.md, lines 1 to ${gf.chapters[0].to}`} set:html={opening.html} />
          <p class="lf-in lf-more"><a class="ds-text-link" data-kind="route" href="/guide/"><span class="ds-text-link__label">Read the whole guide</span><span class="ds-text-link__glyph" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a><span class="lf-more__alt">or carry on at <a class="ds-text-link" href={`/guide/#${second.id}`}>line {second.from}, {second.title}</a></span></p>
        </section>

        <section class="lf-sec" aria-labelledby="toc-title">
          <div class="lf-in lf-intro">
            <h2 class="lf-h2" id="toc-title">{gf.chapters.length} chapters, by line</h2>
            <p class="lf-p">About {gf.minutes} minutes from top to bottom. Each chapter opens at its first line.</p>
          </div>
          <ol class="lf-doc lf-toc">
            {gf.chapters.map(c => <li class="lf-l" data-kind="toc"><span class="lf-n" aria-hidden="true">{c.from}</span><span class="lf-m" aria-hidden="true">##</span><a class="lf-t lf-toc__a" href={`/guide/#${c.id}`}><span class="lf-toc__t">{c.title}</span><span class="lf-toc__r">lines {c.from}–{c.to}{c.subs ? ` · ${c.subs} sections` : ''}</span></a></li>)}
          </ol>
        </section>

        <section class="lf-sec lf-in" id="guides" aria-labelledby="guides-title">
          <h2 class="lf-h2" id="guides-title">{guides.length} shorter guides</h2>
          <p class="lf-p">One question each, with its sources listed at the end. Every guide is also a Markdown file at its own address plus .md. Three from each folder here; the rest are a click away.</p>
          {cats.map(c => { const list = guidesIn(c.id); return (
            <div class="lf-cat" id={`cat-${c.id}`}>
              <div class="lf-cat__head"><h3 class="lf-h3">{c.title}</h3><a class="ds-text-link lf-cat__all" href={`/guides/#${c.id}`}>All {list.length}<span class="ds-sr-only"> {c.title.toLowerCase()} guides</span></a></div>
              <p class="lf-cat__blurb">{c.blurb}</p>
              <ul class="lf-rows">{list.slice(0, 3).map(g => { const s = guideStats(g); return <li class="lf-row"><a class="lf-row__t" href={g.url}>{g.fm.title}</a><span class="lf-row__m">{fmt(s.words)} words · {s.sources} sources</span></li>; })}</ul>
            </div>); })}
          <p class="lf-more"><a class="ds-text-link" data-kind="route" href="/guides/"><span class="ds-text-link__label">Every guide, by folder</span><span class="ds-text-link__glyph" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a></p>
        </section>

        <div class="lf-in"><Signup /></div>
      </div>
    </div>
  </main>
</Base>
