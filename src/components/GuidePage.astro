---
// One guide, read as the file /<slug>.md serves (design/site/DESIGN.md §4): title, Canonical/Publisher/Updated, the
// short answer, the body, From the same studio, Questions people ask, Sources — every line numbered. Read next follows
// the file. Footnotes only where the guide links a source or src/data/footnotes.ts places one (never invented).
import Base from '../layouts/Base.astro';
import FileRail from './FileRail.astro';
import FileBar from './FileBar.astro';
import { site } from '../data/content';
import { footnotes } from '../data/footnotes';
import { renderLines } from '../lib/linefile';
import { guideBySlug, categoryOf, type Guide } from '../lib/guides';
import { guideFileOf, guideStats } from '../lib/site-files';
interface Props { entry: Guide }
const { entry: g } = Astro.props;
const cat = categoryOf(g.fm.category);
const file = guideFileOf(g);
const doc = renderLines(file.lines, 1, file.count, { sources: g.fm.sources, footnotes: footnotes[g.slug], headingId: file.headingId, leadLine: file.leadLine });
const related = (g.fm.related ?? []).map(s => guideBySlug(s)!).filter(Boolean);
const fmtDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const fmt = (n: number) => n.toLocaleString('en-GB');
const url = `${site.url}${g.url}`;
const org = { '@id': `${site.publisher.url}#organization` };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', '@id': `${url}#article`, headline: g.fm.title, description: g.fm.summary, mainEntityOfPage: url, isPartOf: { '@id': `${site.url}/#website` }, inLanguage: 'en-GB', datePublished: g.fm.published, dateModified: g.fm.updated, author: org, publisher: org, image: `${site.url}/og.png`, citation: g.fm.sources.map(s => s.url), wordCount: file.words },
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: g.fm.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'What is GEO', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.url}/guides/` },
    { '@type': 'ListItem', position: 3, name: g.fm.title, item: url } ] },
  { '@type': 'Organization', '@id': org['@id'], name: site.publisher.name, url: site.publisher.url, sameAs: [site.publisher.hilyt] }
] };
---
<Base title={g.fm.seoTitle ?? `${g.fm.title} | What is GEO`} description={g.fm.summary} markdown={g.md} current="guides">
  <main id="main">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <div class="lf-shell" data-page="article">
      <FileRail page="article" guide={g} />
      <div class="lf-pane" data-lf-file={file.count}>
        <nav class="ds-breadcrumb lf-crumbs" aria-label="Breadcrumb"><ol class="ds-breadcrumb__list">
          <li class="ds-breadcrumb__item"><a class="ds-breadcrumb__link" href="/guides/">Guides</a><span class="ds-breadcrumb__sep" aria-hidden="true"></span></li>
          <li class="ds-breadcrumb__item"><a class="ds-breadcrumb__link" href={`/guides/#${cat.id}`}>{cat.title}</a><span class="ds-breadcrumb__sep" aria-hidden="true"></span></li>
          <li class="ds-breadcrumb__item"><span class="ds-breadcrumb__leaf" aria-current="page">{g.slug}.md</span></li>
        </ol></nav>
        <FileBar name={`${g.slug}.md`} meta={[`${file.count} lines`, `${fmt(file.words)} words`, `${file.minutes} min read`, `Updated ${fmtDate(g.fm.updated)}`]} href={g.md} />
        <article class="lf-doc" aria-labelledby="L1-title" set:html={doc.html.replace('<h1 class="lf-t"', '<h1 class="lf-t" id="L1-title"')} />
        <p class="lf-in lf-note lf-disclaimer">Reviewed {fmtDate(g.fm.updated)}. General information about how AI search works, not a promise of placement in any AI answer. New to this? <a class="ds-text-link" href="/guide/">Start with the full guide</a>.</p>
        {related.length > 0 && <nav class="lf-sec lf-in" aria-labelledby="next-title">
          <h2 class="lf-h2" id="next-title">Read next</h2>
          <ul class="lf-rows">{related.map(r => { const s = guideStats(r); return <li class="lf-row" data-kind="next"><a class="lf-row__t" href={r.url}>{r.fm.title}</a><p class="lf-row__s">{r.fm.summary}</p><span class="lf-row__m">{r.slug}.md · {fmt(s.words)} words · {s.sources} sources</span></li>; })}</ul>
        </nav>}
      </div>
    </div>
  </main>
</Base>
