---
// Every page: the vendored design system (src/ds, `loop.mjs sync`), then the linefile layout glue (design/site/DESIGN.md).
import '../ds/index.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/linefile.css';
import { site, updated } from '../data/content';
// Preload the two latin font files every page paints with, so the swap from the fallback face cannot reflow the
// first screen (the home hero centres its content, so a late swap moved all of it).
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface Props {
  title: string; description: string; noindex?: boolean; markdown?: string;
  /** Fleet suggestions card above the footer; off on form pages. */ suggest?: boolean;
  /** Which top-bar route is this page (aria-current). */ current?: 'guide' | 'guides';
  /** Canonical path when it differs from this page's own. */ canonicalPath?: string;
}
const { title, description, noindex = false, markdown = '/guide.md', suggest = true, current, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url);
const reviewedShort = `Reviewed ${updated.replace(/^(\d+) (\w{3})\w* (\d{4})$/, '$1 $2 $3')}`;
const links = [
  { label: 'The guide', href: '/guide/', key: 'guide' },
  { label: 'All guides', href: '/guides/', key: 'guides' },
  { label: 'Get started', href: '/guide/#getting-started', key: 'start' },
];
const wordmark = '<b>w</b>hat<b>i</b>s<b>g</b>eo<i>.</i>';
---
<!doctype html>
<html lang="en-GB" data-theme="whatisgeo" data-mode="dark" data-depth="flat" data-selection="tint" data-buttons="pill" data-labels="sentence" data-controls="sentence" data-accent-scope="action" data-hover="tint" data-density="default" data-texture="none" data-ornament="none" data-illustration="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href={markdown} title="Text version" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="What is GEO" />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="What is GEO — a practical guide to Generative Engine Optimisation" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      try { var t = localStorage.getItem('wig-theme'); document.documentElement.dataset.mode = t === 'light' ? 'light' : t === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : 'dark'; } catch (e) { }
    </script>
  </head>
  <body>
    <a class="ds-button-secondary lf-skip" href="#main"><span class="ds-button-secondary__label">Skip to content</span></a>
    <div class="ds-sec ds-sec-l-nav-01-marketing-top-nav" data-variant="jstov">
      <header class="ds-marketing-nav" data-align="center" data-collapse="cta">
        <div class="ds-marketing-nav__inner">
          <a class="ds-marketing-nav__brand" href="/" aria-label="What is GEO home"><span class="ds-marketing-nav__wordmark lf-wm" set:html={wordmark} /></a>
          <nav class="ds-marketing-nav__drawer" id="nav-drawer" aria-label="Main navigation">
            <ul class="ds-marketing-nav__links">
              {links.map(l => <li><a class="ds-marketing-nav__link" href={l.href} aria-current={l.key === current ? 'page' : undefined}>{l.label}</a></li>)}
            </ul>
            <div class="ds-marketing-nav__actions">
              <a class="ds-marketing-nav__cta" data-cta="outline" href="/#updates">Stay in the loop</a>
            </div>
          </nav>
          <div class="ds-marketing-nav__utilities">
            <a class="ds-marketing-nav__status" href="/guide.md" data-status="version"><span class="ds-marketing-nav__status-text">{reviewedShort}</span></a>
          </div>
          <button class="ds-marketing-nav__menu-toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Menu">
            <svg class="ds-marketing-nav__icon ds-marketing-nav__icon--menu" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
            <svg class="ds-marketing-nav__icon ds-marketing-nav__icon--close" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
          </button>
        </div>
      </header>
    </div>
    <slot />
    {suggest && <aside class="lf-suggest" aria-label="Suggestions"><div class="lf-suggest__in"><div data-suggest></div></div></aside>}
    {suggest && <script is:inline src="/suggest.js" defer data-site-name="whatisgeo.app"></script>}
    <div class="ds-sec ds-sec-l-foot-01-sitemap-footer" data-variant="jstov">
      <footer class="ds-footer" data-variant="jstov" data-headings="rule" data-legal="mono">
        <div class="ds-footer__inner">
          <div class="ds-footer__row">
            <div class="ds-footer__brand">
              <a class="ds-footer__logo" href="/" aria-label="What is GEO home"><span class="ds-footer__wordmark lf-wm" set:html={wordmark} /></a>
              <p class="ds-footer__tagline">A practical, source-linked guide to Generative Engine Optimisation for business owners and marketers. Every page is also a Markdown file.</p>
            </div>
            <div class="ds-footer__groups">
              <nav class="ds-footer__group" aria-labelledby="foot-read">
                <h2 class="ds-footer__group-title" id="foot-read">Read</h2>
                <ul class="ds-footer__list">
                  <li><a class="ds-footer__link" href="/guide/">The guide</a></li>
                  <li><a class="ds-footer__link" href="/guides/">All guides</a></li>
                  <li><a class="ds-footer__link" href="/guide/#getting-started">Get started</a></li>
                </ul>
              </nav>
              <nav class="ds-footer__group" aria-labelledby="foot-machines">
                <h2 class="ds-footer__group-title" id="foot-machines">For machines</h2>
                <ul class="ds-footer__list">
                  <li><a class="ds-footer__link" href="/llms.txt">llms.txt</a></li>
                  <li><a class="ds-footer__link" href="/guide.md">Text version</a></li>
                  <li><a class="ds-footer__link" href="/mcp-server/">MCP server</a></li>
                  <li><a class="ds-footer__link" href={site.source}>Source <svg class="ds-footer__ext" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"/></svg><span class="ds-sr-only">(on GitHub)</span></a></li>
                </ul>
              </nav>
              <nav class="ds-footer__group" aria-labelledby="foot-site">
                <h2 class="ds-footer__group-title" id="foot-site">Site</h2>
                <ul class="ds-footer__list">
                  <li><a class="ds-footer__link" href="/privacy/">Privacy</a></li>
                  <li><a class="ds-footer__link" href={`mailto:${site.contact}`}>Contact</a></li>
                </ul>
              </nav>
            </div>
          </div>
          <hr class="ds-footer__rule" />
          <div class="ds-footer__legal">
            <div class="ds-footer__legal-start">
              <p class="ds-footer__copy">© {new Date().getFullYear()} What is GEO. Operated by {site.publisher.name}. Registered in England and Wales, company no. 10047328, registered office 5 Brayford Square, London E1 0SG. VAT GB362654684.</p>
              <a class="ds-footer__status" href="/guide.md" data-status="ok">{reviewedShort}</a>
            </div>
            <div class="ds-footer__legal-end">
              <fieldset class="ds-footer__theme" role="radiogroup" aria-label="Theme">
                <button class="ds-footer__theme-opt" type="button" role="radio" data-theme-opt="system" aria-checked="true" aria-label="System theme"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.5"/><path d="M6 13.5h4"/></svg></button>
                <button class="ds-footer__theme-opt" type="button" role="radio" data-theme-opt="light" aria-checked="false" aria-label="Light theme"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg></button>
                <button class="ds-footer__theme-opt" type="button" role="radio" data-theme-opt="dark" aria-checked="false" aria-label="Dark theme"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.5 5.5 0 0 1 6.4 2.5a5.5 5.5 0 1 0 7.1 7.1z"/></svg></button>
              </fieldset>
            </div>
          </div>
        </div>
      </footer>
    </div>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/linefile.ts"></script>
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
