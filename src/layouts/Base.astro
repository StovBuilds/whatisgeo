---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/content';
// Preload the two latin font files every page paints with, so the swap from the fallback face cannot reflow the
// first screen (the home hero centres its content, so a late swap moved all of it).
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface Props { title: string; description: string; noindex?: boolean; markdown?: string; /** Fleet suggestions card above the footer; off on form pages. */ suggest?: boolean; }
const { title, description, noindex = false, markdown = '/guide.md', suggest = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en-GB" data-theme="whatisgeo" data-mode="light" data-depth="flat" data-selection="tint" data-buttons="pill" data-labels="sentence" data-controls="sentence" data-accent-scope="action" data-hover="tint" data-density="default" data-texture="none" data-ornament="none" data-illustration="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href={markdown} title="Text version" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="What is GEO" />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="What is GEO — a practical guide to Generative Engine Optimisation" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      try { document.documentElement.dataset.mode = localStorage.getItem('wig-theme') === 'dark' ? 'dark' : 'light'; } catch { }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="What is GEO home"><span class="word"><b>w</b>hat</span><span class="word"><b>i</b>s</span><span class="word"><b>g</b>eo</span><span class="logo-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="/#guide">The guide</a><a href="/guides/">All guides</a><a href="/#getting-started">Get started</a></nav>
      <div class="header-actions"><button class="theme-button" type="button" aria-label="Switch to dark mode" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19.5 15.5A8 8 0 0 1 8.5 4.5a8 8 0 1 0 11 11Z" stroke="currentColor" stroke-width="1.5"/></svg></button><a class="small-cta" href="/#updates">Stay in the loop</a></div>
    </header>
    <slot />
    {suggest && <aside class="suggest-band" aria-label="Suggestions"><div data-suggest></div></aside>}
    {suggest && <script is:inline src="/suggest.js" defer data-site-name="whatisgeo.app"></script>}
    <footer class="site-footer">
      <div class="footer-top"><a class="wordmark" href="/" aria-label="What is GEO home"><span class="word"><b>w</b>hat</span><span class="word"><b>i</b>s</span><span class="word"><b>g</b>eo</span><span class="logo-dot">.</span></a><a class="back-top" href="#">Back to top ↑</a></div>
      <div class="footer-bottom"><p>© {new Date().getFullYear()} What is GEO</p><div><a href="/guides/">Guides</a><a href="/privacy/">Privacy</a><a href="/mcp-server/">MCP server</a><a href={`mailto:${site.contact}`}>Contact</a><a href="/llms.txt">llms.txt</a><a href="/guide.md">Text version</a><a href={site.source}>Source</a></div><p>Operated by <a href={site.publisher.url}>{site.publisher.name}</a>. Registered in England and Wales, company no. 10047328, registered office 5 Brayford Square, London E1 0SG. VAT GB362654684.</p></div>
    </footer>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
